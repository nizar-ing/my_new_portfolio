# ── Contact form ──────────────────────────────────────────────────────────────
# The address that receives contact form submissions.
CONTACT_TO_EMAIL=nizar.ilahi@gmail.com

# ── Resend (default, recommended on Vercel) ───────────────────────────────────
# Create a free account at https://resend.com and paste the API key here.
# In dev/sandbox mode you can only send FROM onboarding@resend.dev to a
# verified recipient.  In production, verify your domain and update RESEND_FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# ── SMTP fallback (e.g. Gmail App Password) ───────────────────────────────────
# Used only when RESEND_API_KEY is not set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.gmail@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Public site URL (used in Phase 8 for metadata / OG) ──────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
